{
  "$schema": "http://json.schemastore.org/template",
  "author": "kojamori",
  "classifications": ["Games", "Mod", "SFS"],
  "identity": "kojamori.SFS.Templates.CodeMod",
  "name": "SFS Code Mod Template",
  "shortName": "sfsmod",
  "sourceName": "generatedModNameId",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "description": "A .NET Framework 4.8 template for creating DLL mods for the video game Spaceflight Simulator (SFS).",
  "symbols": {
    "modNameId": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "The ModNameID for the mod. This is used as the unique identifier for the mod. It should not contain spaces or special characters. If left empty, the project name will be used as the ModNameID.",
      "displayName": "Mod Name ID"
    },
    "generatedModNameId": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "modNameId,name",
        "sourceVariableName": "modNameId",
        "fallbackVariableName": "name"
      },
      "replaces": "generatedModNameId"
    },

    "modDisplayName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "The display name for the mod; what users will see in the in-game mod list. If left empty, the Mod Name ID will be used as the display name.",
      "displayName": "Mod Display Name"
    },
    "generatedModDisplayName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "modDisplayName,generatedModNameId",
        "sourceVariableName": "modDisplayName",
        "fallbackVariableName": "generatedModNameId"
      },
      "replaces": "generatedModDisplayName"
    },

    "author": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "author",
      "description": "The author of the mod. This is used in the mod's metadata and is displayed in the game.",
      "displayName": "Author"
    },

    "modVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.0.0",
      "replaces": "modVersion",
      "description": "The version of the mod.",
      "displayName": "Mod Version"
    },

    "modDescription": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "modDescription",
      "description": "A brief description of the mod. This is displayed in the in-game mod list.",
      "displayName": "Mod Description"
    },

    "minimumGameVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.6.00.16",
      "replaces": "minimumGameVersion",
      "description": "The minimum game version required for the mod to work. Note this has no effect on the mod's compatibility with the game; it is purely informational.",
      "displayName": "Minimum Game Version"
    },

    "autoCopyMod": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Whether to automatically copy the built mod DLL into the SFS mods folder.",
      "displayName": "Automatic DLL Copying"
    },
    "generatedAutoCopyMod": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "autoCopyMod",
        "toLower": true
      },
      "replaces": "generatedAutoCopyMod"
    },

    "autoCopyPdb": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Whether to automatically copy the built mod DLL's .pdb (Program Database) into the mod folder for debugging.",
      "displayName": "Automatic PDB Copying"
    },
    "generatedAutoCopyPdb": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "autoCopyPdb",
        "toLower": true
      },
      "replaces": "generatedAutoCopyPdb"
    },

    "licenseType": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "MIT",
      "choices": [
        {
          "choice": "MIT",
          "displayName": "MIT License",
          "description": "MIT License"
        },
        {
          "choice": "LGPL (v3)",
          "displayName": "GNU Lesser General Public License v3",
          "description": "GNU Lesser General Public License v3"
        },
        {
          "choice": "GPL (v3)",
          "displayName": "GNU General Public License v3",
          "description": "GNU General Public License v3"
        },
        {
          "choice": "AGPL (v3)",
          "displayName": "GNU Affero General Public License v3",
          "description": "GNU Affero General Public License v3"
        },
        {
          "choice": "apache2.0",
          "displayName": "Apache License 2.0",
          "description": "Apache License 2.0"
        },
        {
          "choice": "mozilla2.0",
          "displayName": "Mozilla Public License 2.0",
          "description": "Mozilla Public License 2.0"
        },
        {
          "choice": "unlicense",
          "displayName": "The Unlicense",
          "description": "The Unlicense"
        },
        {
          "choice": "none",
          "displayName": "No License",
          "description": "No license. The mod will not include a license file."
        }
      ],
      "replaces": "licenseType",
      "description": "The open source license type for the mod. This is used in the mod's metadata.",
      "displayName": "License Type"
    },

    "harmony": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Whether to include Harmony boilerplate in the mod. Harmony is a library for patching .NET methods at runtime, allowing mods to modify the behavior of the game without modifying its source code.",
      "displayName": "Include Harmony Boilerplate"
    },

    "implicitManagedReferences": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Whether to implicitly include all managed DLLs as references. If set to false, only Assembly-CSharp.dll, UnityEngine.dll, 0Harmony.dll and UnityEngine.CoreModule.dll will be included as references. This can reduce naming conflicts.",
      "displayName": "Include Implicit Managed References"
    },
    
    "generatedImplicitManagedReferences": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "implicitManagedReferences",
        "toLower": true
      },
      "replaces": "generatedImplicitManagedReferences"
    },

    "updateBoilerplate": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Whether to include the boilerplate code for automatic updating using Neptune-Sky's UITools' IUpdatable interface. Details at https://github.com/cucumber-sp/UITools.",
      "displayName": "Include Automatic DLL Updating Boilerplate (Deprecated)"
    },

    "fileScopedNamespace": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Whether to make the entrypoint class file use a file-scoped namespace.",
      "displayName": "File-scoped Namespace"
    },

    "entrypointClassName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "Main",
      "description": "The name of the entrypoint class.",
      "displayName": "Entrypoint Class Name",
      "replaces": "entrypointClassName"
    },

    "assemblyName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "The assembly name for the generated project. If left empty, the Mod Name ID will be used as the assembly name.",
      "displayName": "Assembly Name"
    },
    "generatedAssemblyName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "assemblyName,generatedModNameId",
        "sourceVariableName": "assemblyName",
        "fallbackVariableName": "generatedModNameId"
      },
      "replaces": "generatedAssemblyName"
    },

    "rootNamespace": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "The root namespace of the assembly. Defaults to the ModNameID if left empty.",
      "displayName": "Root Namespace"
    },
    "generatedRootNamespace": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "rootNamespace,generatedModNameId",
        "sourceVariableName": "rootNamespace",
        "fallbackVariableName": "generatedModNameId"
      },
      "replaces": "generatedRootNamespace"
    },

    "readMeDescription": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "The description in the mod's README. Defaults to the mod description.",
      "displayName": "README Description"
    },
    "generatedReadMeDescription": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "readMeDescription,modDescription",
        "sourceVariableName": "readMeDescription",
        "fallbackVariableName": "modDescription"
      },
      "replaces": "generatedReadMeDescription"
    },

    "socials": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Whether to include a social media section in the README.",
      "displayName": "README Social Media Section"
    },

    "discordLink": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "The Discord invite link for the mod's server. This is displayed in the socials section of the README.",
      "displayName": "Discord Invite Link",
      "replaces": "discordLink"
    },

    "creditSmg": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Whether to include a section and link to the SFS Modding Guide (SMG) in the README."
    },

    "copyrightHolder": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "The copyright holder for the mod. Defaults to the author.",
      "displayName": "Copyright Holder"
    },
    "generatedCopyrightHolder": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "source": "copyrightHolder,author",
        "sourceVariableName": "copyrightHolder",
        "fallbackVariableName": "author"
      },
      "replaces": "generatedCopyrightHolder"
    },

    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "copyrightYear",
      "parameters": {
        "format": "yyyy"
      }
    },

    "git": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Whether to initialize a local Git repository in the generated project folder.",
      "displayName": "Initialize Git Repository"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(licenseType == 'MIT')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.MIT": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'LGPL (v3)')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.LGPLv3": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'GPL (v3)')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.GPLv3": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'AGPL (v3)')",
          "exclude": [
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.AGPLv3": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'apache2.0')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.apache2.0": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'mozilla2.0')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.unlicense"
          ],
          "rename": {
            "LICENSE.mozilla2.0": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'unlicense')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0"
          ],
          "rename": {
            "LICENSE.unlicense": "LICENSE"
          }
        },
        {
          "condition": "(licenseType == 'none')",
          "exclude": [
            "LICENSE.AGPLv3",
            "LICENSE.apache2.0",
            "LICENSE.GPLv3",
            "LICENSE.LGPLv3",
            "LICENSE.MIT",
            "LICENSE.mozilla2.0",
            "LICENSE.unlicense"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "condition": "(git)",
      "description": "Initialize local Git repository",
      "manualInstructions": [
        {
          "text": "Run 'git init'."
        }
      ],
      "args": {
        "args": "init",
        "executable": "git"
      },
      "continueOnError": true
    }
  ]
}
